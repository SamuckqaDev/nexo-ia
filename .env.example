NEXO_DATABASE_NAME=nexo
NEXO_DATABASE_USER=nexo
NEXO_DATABASE_PASSWORD=replace-with-a-long-random-development-password
NEXO_DATABASE_URL=jdbc:postgresql://localhost:5432/nexo
NEXO_OLLAMA_BASE_URL=http://localhost:11434
NEXO_CONTAINER_OLLAMA_BASE_URL=http://host.containers.internal:11434
NEXO_SERVER_ADDRESS=127.0.0.1
NEXO_SERVER_PORT=8080
NEXO_WEB_PORT=8088
NEXO_FRONTEND_DEV_PORT=5173
NEXO_SECURE_COOKIE=false
NEXO_JWT_SECRET=replace-with-base64-encoded-32-byte-or-longer-random-secret
NEXO_SMTP_HOST=host.containers.internal
NEXO_SMTP_PORT=1025
NEXO_CONTAINER_SMTP_HOST=host.containers.internal
NEXO_CONTAINER_SMTP_PORT=1025
